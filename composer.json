{
    "name": "silarhi/ux-icons-js-bundle",
    "description": "Render Symfony UX Icons in JavaScript, React, Preact and Vue, with the same attributes and configuration as ux_icon() — the PHP companion to @silarhi/ux-icons-js",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "icons",
        "svg",
        "react",
        "preact",
        "vue",
        "symfony-ux",
        "ux-icons",
        "iconify",
        "typescript"
    ],
    "authors": [
        {
            "name": "Guillaume Sainthillier",
            "email": "guillaume@silarhi.fr"
        }
    ],
    "homepage": "https://ux-icons-js-bundle.silarhi.dev",
    "support": {
        "issues": "https://github.com/silarhi/ux-icons-js-bundle/issues",
        "source": "https://github.com/silarhi/ux-icons-js-bundle",
        "docs": "https://ux-icons-js-bundle.silarhi.dev"
    },
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/finder": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/ux-icons": "^2.36.1 || ^3.5"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.54.0",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.2",
        "phpstan/phpstan-strict-rules": "^2.1.0",
        "phpstan/phpstan-symfony": "^2.1.0",
        "phpunit/phpunit": "^11.5.57 || ^12.5.38 || ^13.4.1",
        "rector/rector": "^2.8.1",
        "symfony/asset-mapper": "^6.4 || ^7.0 || ^8.0",
        "symfony/error-handler": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "symfony/asset-mapper": "Maps the dumped icons as \"var/icons\" in the importmap"
    },
    "autoload": {
        "psr-4": {
            "Silarhi\\UxIconsJsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Silarhi\\UxIconsJsBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "audit": {
            "block-insecure": false
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "scripts": {
        "bump:tools": "@composer bump ergebnis/composer-normalize friendsofphp/php-cs-fixer phpstan/* phpunit/phpunit rector/rector",
        "test": "phpunit"
    }
}
