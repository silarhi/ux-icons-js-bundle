{
    "name": "@silarhi/ux-icons-js",
    "description": "Render Symfony UX Icons in JavaScript, React, Preact and Vue, with the same attributes and configuration as ux_icon()",
    "version": "0.0.0-development",
    "license": "MIT",
    "author": "SILARHI <dev@silarhi.fr>",
    "homepage": "https://ux-icons-js-bundle.silarhi.dev",
    "keywords": [
        "symfony-ux",
        "icons",
        "svg",
        "react",
        "preact",
        "vue"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/silarhi/ux-icons-js-bundle.git"
    },
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "dist/index.mjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./react": {
            "types": "./dist/react.d.mts",
            "import": "./dist/react.mjs"
        },
        "./preact": {
            "types": "./dist/preact.d.mts",
            "import": "./dist/preact.mjs"
        },
        "./vue": {
            "types": "./dist/vue.d.mts",
            "import": "./dist/vue.mjs"
        }
    },
    "sideEffects": false,
    "scripts": {
        "build": "tsdown",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "biome check src test",
        "lint:fix": "biome check --write src test"
    },
    "peerDependencies": {
        "preact": "^10.0 || ^11.0",
        "react": "^18.0 || ^19.0",
        "vue": "^3.0"
    },
    "peerDependenciesMeta": {
        "preact": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "vue": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/coverage-v8": "^5.0.5",
        "jsdom": "^30.0.0",
        "preact": "^11.0.1",
        "preact-render-to-string": "^6.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tsdown": "^0.23.1",
        "typescript": "^7.0.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.0",
        "vue": "^3.5.44"
    },
    "packageManager": "pnpm@12.15.0"
}
